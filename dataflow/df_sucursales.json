{
	"name": "df_sucursales",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "sucursales_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "sucursales_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "Split2"
				},
				{
					"name": "validarDelivery"
				}
			],
			"scriptLines": [
				"source(output(",
				"          sucursal_id as string,",
				"          restaurante_id as string,",
				"          nombre_sucursal as string,",
				"          ciudad as string,",
				"          zona as string,",
				"          direccion as string,",
				"          capacidad_mesas as string,",
				"          tiene_delivery as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(sucursal_id = upper(trim(sucursal_id)),",
				"          restaurante_id = upper(trim(restaurante_id)),",
				"          nombre_sucursal = initCap(lower(trim(nombre_sucursal))),",
				"          ciudad = initCap(lower(trim(ciudad))),",
				"          zona = initCap(lower(trim(zona))),",
				"          direccion = trim(direccion),",
				"          tiene_delivery = lower(trim(tiene_delivery)),",
				"          capacidad_mesas = trim(capacidad_mesas)) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(sucursal_id) && sucursal_id != '' && !isNull(restaurante_id) && restaurante_id != '' && !isNull(nombre_sucursal) && nombre_sucursal != '' && !isNull(ciudad) && ciudad != '' && !isNull(zona) && zona != '' && !isNull(direccion) && direccion != '' && !isNull(capacidad_mesas) && capacidad_mesas != '' && !isNull(tiene_delivery) && tiene_delivery != '',",
				"     disjoint: false) ~> split1@(validos, rechazados)",
				"split1@validos aggregate(groupBy(sucursal_id),",
				"     restaurante_id = first(restaurante_id),",
				"          nombre_sucursal = first(nombre_sucursal),",
				"          ciudad = first(ciudad),",
				"          zona = first(zona),",
				"          direccion = first(direccion),",
				"          capacidad_mesas = first(capacidad_mesas),",
				"          tiene_delivery = first(tiene_delivery)) ~> aggregate1",
				"validarDelivery@validosDelivery derive(capacidad_mesas = toInteger(capacidad_mesas),",
				"          tiene_delivery = lower(trim(tiene_delivery)) == 'sí' || lower(trim(tiene_delivery)) == 'si') ~> derivedColumn2",
				"derivedColumn2 split(capacidad_mesas > 0,",
				"     disjoint: false) ~> Split2@(validosReglas, rechazadosReglas)",
				"aggregate1 split(lower(trim(tiene_delivery)) == 'sí' || lower(trim(tiene_delivery)) == 'si' || lower(trim(tiene_delivery)) == 'no',",
				"     disjoint: false) ~> validarDelivery@(validosDelivery, rechazadosDelivery)",
				"Split2@validosReglas sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          sucursal_id as string,",
				"          restaurante_id as string,",
				"          nombre_sucursal as string,",
				"          ciudad as string,",
				"          zona as string,",
				"          direccion as string,",
				"          capacidad_mesas as integer,",
				"          tiene_delivery as boolean",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          sucursal_id,",
				"          restaurante_id,",
				"          nombre_sucursal,",
				"          ciudad,",
				"          zona,",
				"          direccion,",
				"          capacidad_mesas,",
				"          tiene_delivery",
				"     )) ~> sink1"
			]
		}
	}
}